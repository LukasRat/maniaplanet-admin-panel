# ManiaPlanet Admin Panel - Environment Configuration
# 
# IMPORTANT: This file is a TEMPLATE. 
# Copy this file to create your actual configuration file named ".env" (exactly):
#
#   cp .env.example .env
#
# Then edit the .env file (NOT this .env.example file) with your settings.
# The .env file will be automatically read by Docker Compose and the application.
#
# NOTE: The file MUST be named ".env" (with a dot at the beginning, no extension)
#       This is the standard convention for environment configuration files.

# ==================
# Application Ports
# ==================

# HTTP port for the admin panel web interface (default: 3100)
HTTP_PORT=3100

# Host to bind the HTTP server to (default: 0.0.0.0 - all interfaces)
HTTP_HOST=0.0.0.0

# ==================
# ManiaPlanet Server Connection
# ==================

# XML-RPC host of your ManiaPlanet server (default: 127.0.0.1)
RPC_HOST=127.0.0.1

# XML-RPC port of your ManiaPlanet server (default: 5000)
RPC_PORT=5000

# XML-RPC login for SuperAdmin access (default: SuperAdmin)
RPC_LOGIN=SuperAdmin

# ==================
# Maps Directory
# ==================

# Path to your ManiaPlanet server's Maps directory
# This is the directory where map files (.gbx) are stored
# 
# Examples:
#   Linux: /home/user/maniaplanet-server/UserData/Maps
#   Windows: C:\ManiaPlanetServer\UserData\Maps
#   Docker: /maps (use volume mount in docker-compose.yml)
MANIAPLANET_MAPS_DIR=/maps
